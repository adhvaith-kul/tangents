# Copy this file to .env.local and edit it. .env.local is git-ignored: never commit keys.

# Which model backend runs the simulation.
#   cli = the Claude Code command line (`claude`), billed to your Claude subscription. No key needed.
#   api = the Anthropic API, billed to ANTHROPIC_API_KEY.
#   gemini = the Google Gemini API, billed to GEMINI_API_KEY.
LLM_BACKEND=cli

# Needed for LLM_BACKEND=api. Create one at https://console.anthropic.com (API keys).
# With a key set, the production build (npm run demo:build, npm run demo) uses the API
# even when LLM_BACKEND=cli, so development stays on the subscription and a demo runs on the key.
# ANTHROPIC_API_KEY=

# Optional. cli, api or gemini: what the production build uses, whatever keys are set.
# LLM_BACKEND_PRODUCTION=cli

# Needed only for LLM_BACKEND=gemini. Create one at https://aistudio.google.com (API keys).
# GEMINI_API_KEY=

# Optional. Lets ordinary accounts reply with GIFs. Create one at https://developers.giphy.com (Create an App, API).
# GIPHY_API_KEY=
