# Copy this file to .env.local and edit it. .env.local is git-ignored: never commit keys.

# Which model backend runs the simulation.
#   cli = the Claude Code command line (`claude`), billed to your Claude subscription. No key needed.
#   api = the Anthropic API, billed to ANTHROPIC_API_KEY.
LLM_BACKEND=cli

# Needed only for LLM_BACKEND=api. Create one at https://console.anthropic.com (API keys).
# ANTHROPIC_API_KEY=

# Optional. Lets ordinary accounts reply with GIFs. Create one at https://developers.giphy.com (Create an App, API).
# GIPHY_API_KEY=
